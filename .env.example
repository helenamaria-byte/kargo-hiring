# Supabase → Project Settings → API. Use the service_role / secret key (server-only, never NEXT_PUBLIC_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Google AI Studio key. GEMINI_MODEL is pinned so every CV is scored by the same model.
# Free tier: Flash Lite allows 500 requests/day (enough for ~160 CVs); full Flash only 20/day.
GEMINI_API_KEY=
GEMINI_MODEL=
# Leave blank until ready. RESEND_FROM must be on a domain verified in Resend, e.g. "Arjun <arjun@kargo.example>".
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
# Password for the whole site (any username). Required in production.
DASHBOARD_PASSWORD=
# Only used by `npm run db:setup` from your computer (Supabase → Connect → Session pooler). Not needed on Vercel.
DATABASE_URL=
